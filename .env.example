# Un solo .env para backend/ (FastAPI, python-dotenv/pydantic-settings) y
# frontend/ (Vite, envDir apunta acá) -- copiar a ".env" en esta misma carpeta
# (resoluciones/.env), no dentro de backend/ ni frontend/.

# ============================================================================
# backend/ (FastAPI, puerto 8080)
# ============================================================================

# Base de datos. SQLite por defecto para dev (no requiere instalar nada).
# Para usar la BD real del ERP (idec_erp, schema "resolutions" ya creado con
# sus tablas): postgresql://usuario:clave@host:5432/idec_erp
DATABASE_URL=sqlite:///./resoluciones.db

# Schema de Postgres (se ignora en SQLite). "resolutions" es el que ya existe
# en idec_erp con las tablas `resolutions` / `resolution_pages`.
DB_SCHEMA=resolutions

# Keycloak (MISMO realm/cliente que la app movil y el proyecto-erp)
KEYCLOAK_URL=https://auth.catastrocbba.com
KEYCLOAK_REALM=alcaldia-idec
KEYCLOAK_CLIENT_ID=app-idec
# El cliente app-idec es "confidential" -> necesita secret para el login ROPC.
# Mismo valor que EXPO_PUBLIC_KEYCLOAK_CLIENT_SECRET (app movil) y
# KEYCLOAK_CLIENT_SECRET (idec-erp-back). NO se expone al navegador: solo lo
# usa este backend contra Keycloak.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TIMEOUT_SECONDS=20

# CORS: origen del frontend web (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

PORT=8080

# ============================================================================
# frontend/ (Vite, puerto 5173) -- variables con prefijo VITE_ obligatorio
# ============================================================================

# Backend del modulo Resoluciones (backend/, "python -m app.main")
VITE_API_URL=http://localhost:8080

# Servicio OCR de GAMC (PaddleOCR con cola). El navegador le pega directo.
VITE_OCR_API_URL=https://ocr.catastrocbba.com

# Umbral de confianza: celdas por debajo de esto se marcan en rojo para revisar.
VITE_OCR_THRESHOLD=0.85
