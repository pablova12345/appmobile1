# Copiar a ".env" y completar. Nunca commitear el .env real.

# "ollama"    -> gratis, usa un modelo local via Ollama (OLLAMA_URL/OLLAMA_MODEL
#                abajo, hoy qwen3-vl:2b -- ver server/ollama/README.md). Es lo
#                que se usa para el modulo "Estudiar con la IA" (clasificar +
#                preguntas preescritas): se prioriza velocidad sobre calidad.
# "anthropic" -> Claude Haiku/Sonnet, requiere ANTHROPIC_API_KEY con saldo
#                cargado en console.anthropic.com.
# Las resoluciones NO dependen de esto: van por su apartado propio en la app y
# usan solo OCR (OCR_API_URL abajo, /api/hoja2/extract).
AI_PROVIDER=ollama

# Solo si AI_PROVIDER=ollama. Si Ollama corre en ESTA misma PC dejar 127.0.0.1;
# si corre en otra maquina, poner su IP en la red local y arrancar Ollama con
# OLLAMA_HOST=0.0.0.0. OLLAMA_MODEL puede ser el modelo base "qwen3-vl:2b" o el
# creado con server/ollama/Modelfile (ollama create apptramites-clasificador
# -f Modelfile) -- ver server/ollama/README.md.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b

# Opcional. Cuanto mantiene Ollama el modelo cargado en VRAM entre pedidos.
# El server ya manda keep_alive:-1 en cada request (modelo siempre residente)
# y hace un warmup al arrancar; esta variable solo la piso si haria falta otro
# valor (ej. "10m"). El sintoma de NO tenerlo: el primer pedido tras 5 min de
# inactividad tarda ~1 min y el celular lo corta ("network connection lost").
OLLAMA_KEEP_ALIVE=-1

# Solo si AI_PROVIDER=anthropic. Este backend es el UNICO lugar donde debe
# existir esta key -- la app movil nunca la ve.
ANTHROPIC_API_KEY=

# Servicio OCR real de GAMC (PaddleOCR con cola). Lo usa /api/hoja2/extract
# para leer la tabla "RELACION DE SUPERFICIE" -- no depende de AI_PROVIDER.
OCR_API_URL=https://ocr.catastrocbba.com

# Puerto donde escucha este servicio.
PORT=4000

# Origenes permitidos para CORS, separados por coma. "*" en desarrollo.
CORS_ORIGIN=*
